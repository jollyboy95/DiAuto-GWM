<variant
    name="githubDebug"
    useSupportLibraryVectorDrawables="true"
    package="com.andrerinas.openheadunit"
    minSdkVersion="16"
    targetSdkVersion="36.0"
    debuggable="true"
    mergedManifest="build/intermediates/merged_manifest/githubDebug/processGithubDebugMainManifest/AndroidManifest.xml"
    manifestMergeReport="build/outputs/logs/manifest-merger-github-debug-report.txt"
    partialResultsDir="build/intermediates/unit_test_lint_partial_results/githubDebug/lintAnalyzeGithubDebugUnitTest/out">
  <buildFeatures
      namespacing="REQUIRED"/>
  <sourceProviders>
  </sourceProviders>
  <testSourceProviders>
    <sourceProvider
        manifests="src/test/AndroidManifest.xml"
        javaDirectories="src/test/java:src/testGithub/java:src/testDebug/java:src/testGithubDebug/java:src/test/kotlin:src/testGithub/kotlin:src/testDebug/kotlin:src/testGithubDebug/kotlin"
        assetsDirectories="src/test/assets:src/testGithub/assets:src/testDebug/assets:src/testGithubDebug/assets"
        unitTest="true"/>
  </testSourceProviders>
  <testFixturesSourceProviders>
  </testFixturesSourceProviders>
  <artifact
      type="UNIT_TEST">
  </artifact>
</variant>
